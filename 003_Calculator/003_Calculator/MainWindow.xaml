<Window x:Class="_003_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_003_Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="T1" HorizontalAlignment="Left" Margin="77,153,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" FontSize="24" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="T2" HorizontalAlignment="Left" Margin="296,153,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" FontSize="24" RenderTransformOrigin="1.517,0.031"/>
        <Button Content="=" HorizontalAlignment="Left" Margin="448,152,0,0" VerticalAlignment="Top" FontSize="24" Click="Button_Click"/>
        <Label x:Name="Answer" Content="0" HorizontalAlignment="Left" Margin="495,149,0,0" VerticalAlignment="Top" FontSize="24"/>
        <RadioButton x:Name="Sub" Content="-" HorizontalAlignment="Left" Margin="231,131,0,0" VerticalAlignment="Top" FontSize="24"/>
        <RadioButton x:Name="Div" Content="÷" HorizontalAlignment="Left" Margin="228,227,0,0" VerticalAlignment="Top" FontSize="24"/>
        <RadioButton x:Name="Add" Content="+" HorizontalAlignment="Left" Margin="228,89,0,0" VerticalAlignment="Top" FontSize="24" Checked="RadioButton_Checked"/>
        <RadioButton x:Name="Multi" Content="×" HorizontalAlignment="Left" Margin="231,178,0,0" VerticalAlignment="Top" FontSize="24"/>

    </Grid>
</Window>
