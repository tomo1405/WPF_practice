<Window x:Class="_005_Janken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_005_Janken"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Image x:Name="Player" HorizontalAlignment="Left" Height="153" Margin="163,114,0,0" VerticalAlignment="Top" Width="144" Source="/Assets/janken_gu.png"/>
        <Button x:Name="Gu" Content="グー" HorizontalAlignment="Left" Margin="251,314,0,0" VerticalAlignment="Top" FontSize="36" Click="Gu_Click"/>
        <Button x:Name="Choki" Content="チョキ" HorizontalAlignment="Center" Margin="0,314,0,0" VerticalAlignment="Top" FontSize="36" Click="Choki_Click"/>
        <Button x:Name="Pa" Content="パー" HorizontalAlignment="Left" Margin="495,314,0,0" VerticalAlignment="Top" FontSize="36" Click="Pa_Click"/>
        <Label Content="Player" HorizontalAlignment="Left" Margin="182,51,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Image x:Name="PCHand" HorizontalAlignment="Left" Height="153" Margin="504,114,0,0" VerticalAlignment="Top" Width="144" Source="/Assets/janken_gu.png"/>
        <Label Content="PC" HorizontalAlignment="Left" Margin="550,51,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Button x:Name="Janken" Content="じゃんけん" HorizontalAlignment="Center" Margin="0,176,0,0" VerticalAlignment="Top" FontSize="36" Click="Janken_Click"/>
        <Label x:Name="Judge" Content="勝敗" HorizontalAlignment="Center" Margin="0,113,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Label x:Name="Count" Content="連勝" HorizontalAlignment="Left" Margin="94,311,0,0" VerticalAlignment="Top" FontSize="36"/>

    </Grid>
</Window>
